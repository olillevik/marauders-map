{
  "name": "marauders-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/with-keychain-secret.sh node --env-file-if-exists=.env src/server/dev.ts",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --mode full --coverage",
    "test:full": "sh scripts/with-keychain-secret.sh node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --mode full",
    "prepare": "husky"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
